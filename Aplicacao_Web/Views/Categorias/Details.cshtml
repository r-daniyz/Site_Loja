@model Aplicacao_Web.Models.Categoria

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center mb-3">
                <h1 class="display-6 text-primary">Detalhes da Categoria</h1>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h4 class="mb-0 text-secondary">
                        <i class="bi bi-info-circle"></i> Informações do Registro
                    </h4>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-secondary">
                            @Html.DisplayNameFor(model => model.Nome)
                        </dt>
                        <dd class="col-sm-9 fw-bold">
                            @Html.DisplayFor(model => model.Nome)
                        </dd>

                        <hr class="my-3 text-muted" />

                        <dt class="col-sm-3 text-secondary">
                            @Html.DisplayNameFor(model => model.Descricao)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Descricao)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-end py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary me-2">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4">
                        <i class="bi bi-pencil-square"></i> Editar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@* Link para os ícones *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">