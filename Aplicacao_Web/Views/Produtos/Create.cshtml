@model Aplicacao_Web.Models.Produto

@{
    ViewData["Title"] = "Novo Produto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center mb-3">
                <h1 class="display-6 text-primary">Novo Produto</h1>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h4 class="mb-0 text-secondary">Detalhes do Produto</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Nome" class="control-label fw-bold"></label>
                                    <input asp-for="Nome" class="form-control" placeholder="Ex: Monitor Gaming" />
                                    <span asp-validation-for="Nome" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="CategoriaId" class="control-label fw-bold">Categoria</label>
                                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                        <option value="">-- Selecione uma Categoria --</option>
                                    </select>
                                </div>

                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="Preco" class="control-label fw-bold"></label>
                                            <div class="input-group">
                                                <span class="input-group-text">€</span>
                                                <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                                            </div>
                                            <span asp-validation-for="Preco" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="Estoque" class="control-label fw-bold">Stock</label>
                                            <input asp-for="Estoque" class="form-control" />
                                            <span asp-validation-for="Estoque" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="SKU" class="control-label fw-bold"></label>
                                    <input asp-for="SKU" class="form-control" placeholder="Ex: PROD-001" />
                                    <span asp-validation-for="SKU" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label class="control-label fw-bold">Foto do Produto</label>
                                    <input type="file" name="imagemFicheiro" class="form-control" accept="image/*" />
                                    <small class="text-muted">Selecione uma imagem quadrada para melhor visualização.</small>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Descricao" class="control-label fw-bold"></label>
                                    <textarea asp-for="Descricao" class="form-control" rows="2"></textarea>
                                    <span asp-validation-for="Descricao" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-success px-4 shadow-sm">
                                <i class="bi bi-check-lg"></i> Salvar Produto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">