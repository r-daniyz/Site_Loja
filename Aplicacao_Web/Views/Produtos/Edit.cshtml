@model Aplicacao_Web.Models.Produto

@{
    ViewData["Title"] = "Editar " + Model.Nome;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="d-flex align-items-center mb-3">
                @* Agora mostramos o nome do produto no título principal *@
                <h1 class="display-6 text-primary">Editar: @Model.Nome</h1>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    @* Substituímos o ID pelo nome aqui também *@
                    <h4 class="mb-0 text-secondary">
                        <i class="bi bi-pencil-square"></i> Detalhes do Produto
                    </h4>
                    <span class="badge bg-primary">Modo Edição</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImagemUrl" />
                        <input type="hidden" asp-for="DataCadastro" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Nome" class="control-label fw-bold"></label>
                                    <input asp-for="Nome" class="form-control" />
                                    <span asp-validation-for="Nome" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="CategoriaId" class="control-label fw-bold">Categoria</label>
                                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
                                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="Preco" class="control-label fw-bold"></label>
                                            <div class="input-group">
                                                <span class="input-group-text">€</span>
                                                <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                                            </div>
                                            <span asp-validation-for="Preco" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="Estoque" class="control-label fw-bold">Stock</label>
                                            <input asp-for="Estoque" class="form-control" />
                                            <span asp-validation-for="Estoque" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3 text-center border rounded p-2 bg-light">
                                    <label class="control-label fw-bold d-block mb-2">Imagem Atual</label>
                                    @if (!string.IsNullOrEmpty(Model.ImagemUrl))
                                    {
                                        <img src="~/imagens/@Model.ImagemUrl" class="img-thumbnail shadow-sm mb-2" style="max-height: 120px;" />
                                    }
                                    else
                                    {
                                        <div class="text-muted p-3"><i class="bi bi-image" style="font-size: 2rem;"></i><br>Sem foto</div>
                                    }
                                    <input type="file" name="imagemFicheiro" class="form-control mt-2" accept="image/*" />
                                    <small class="text-muted">Selecione para substituir a foto.</small>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="SKU" class="control-label fw-bold"></label>
                                    <input asp-for="SKU" class="form-control" />
                                    <span asp-validation-for="SKU" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12 mt-2">
                                <div class="form-group">
                                    <label asp-for="Descricao" class="control-label fw-bold"></label>
                                    <textarea asp-for="Descricao" class="form-control" rows="2"></textarea>
                                    <span asp-validation-for="Descricao" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-save"></i> Guardar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">